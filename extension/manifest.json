{
  "manifest_version": 3,
  "name": "DOMY",
  "version": "0.6.2",
  "description": "Organize open tabs into personal collections on every new tab.",
  "permissions": ["tabs", "favicon"],
  "chrome_url_overrides": {"newtab": "index.html"},
  "action": {"default_popup": "popup.html", "default_title": "Save in DOMY"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save current page"}}
}
